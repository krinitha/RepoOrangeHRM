    "allure-playwright": "^3.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "@playwright/test": "^1.51.1",
    "playwright": "^1.51.1",
